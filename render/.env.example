# Copy this file to .env and fill in your key.
# .env is gitignored.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: colon-separated list of other repos' refs/ dirs for `lexicon want`
# to also search (besides this repo's own refs/). Unset by default.
# LEXICON_SIBLING_REFS_DIRS=/path/to/other-repo/refs:/path/to/another/refs
